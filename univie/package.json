{
  "name": "plugin-univie",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "pluginMetadata": {
    "id": "plugin-univie",
    "name": "University of Vienna",
    "description": "Univie plugin: config, sidebar, footer, landing page, empty state, event calendar.",
    "category": "feature",
    "icon": "School",
    "replacesJarScopes": ["management_ui_plugin_univie"],
    "workspaceDependencies": {
      "@oc-mui/plugin-system": ">=1.0.0"
    }
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./dist/plugin-univie-app.mjs",
    "./footer": "./dist/plugin-univie-footer.mjs",
    "./landing-page": "./dist/plugin-univie-landing-page.mjs",
    "./sidebar": "./dist/plugin-univie-sidebar.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@oc-mui/app-runtime": "workspace:*",
    "@oc-mui/i18n": "workspace:*",
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/query": "workspace:*",
    "@oc-mui/router": "workspace:*",
    "@oc-mui/ui": "workspace:*",
    "@oc-mui/utils": "workspace:*",
    "lucide-react": "^0.417.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@oc-mui/tailwind-config": "workspace:*",
    "@oc-mui/vite-config": "workspace:*",
    "eslint": "^9.9.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.5.4",
    "vite": "^6.3.5"
  }
}
